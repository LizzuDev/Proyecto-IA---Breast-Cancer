# URL del backend en desarrollo o producción
# Local: http://127.0.0.1:8000
# Producción en la nube: https://tu-backend-en-render.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# --- Backend (variables leídas por backend/app/config.py) ---
# Orígenes permitidos por CORS, separados por comas. En producción, el dominio del frontend.
# CORS_ORIGINS=https://tu-frontend.vercel.app
# Carpeta de artefactos alternativa (por defecto backend/artifacts).
# ARTIFACTS_DIR=/ruta/a/artifacts
